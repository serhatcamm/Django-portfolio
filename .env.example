# Django settings
# REQUIRED when DJANGO_DEBUG=False: set a real, long, random value.
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# False is the secure default (no debug error pages). True for local dev.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# "development" or "production" (production enables HTTPS/HSTS hardening)
ENVIRONMENT=development

# Credentials for the superuser auto-created on first container start
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password
DJANGO_SUPERUSER_EMAIL=admin@example.com
